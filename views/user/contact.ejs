<%- include('../partials/documentHead', { pageTitle: 'İletişim' }) %>
<body>

	<%- include('../partials/head.ejs') %>

		<!-- End Header Area -->
	
		<!-- Breadcrumbs -->
		<div class="breadcrumbs overlay">
			<div class="container">
				<div class="bread-inner">
					<div class="row">
						<div class="col-12">
							<h2>İletişim </h2>
							<ul class="bread-list">
								<li><a href="/">Ana Sayfa</a></li>
								<li><i class="fa fa-angle-right"></i></li>
								<li class="active">İletişim</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- End Breadcrumbs -->
				
		<!-- Start Contact Us -->
        <!-- HTML kısmı aynı kalacak -->
        <!-- Start Contact Us -->
        <!-- Start Contact Us -->
        <section class="contact-us section">
            <div class="container">
                <div class="inner">
                    <div class="row"> 
                        <div class="col-lg-12">
                            <div class="contact-us-form">
                                <h2>Benimle İletişime Geçin</h2>
                                <p>Kafanıza takılan herhangi bir durum için iletişime geçebilirsiniz</p>
                                <!-- Form -->
                                <form class="form" id="request" action="/contact" method="POST">
                                    <div class="col-md-12">
                                        <div style="display:none ;" class="alert alert-success" id="sendMessage"></div>
                                     </div>

                                    <div class="row">
                                        <div class="col-lg-6">
                                            <div class="form-group">
                                                <input type="text" name="name" placeholder="İsim" required="">
                                            </div>
                                        </div>
                                        <div class="col-lg-6">
                                            <div class="form-group">
                                                <input type="email" name="email" placeholder="Email" required="" style="text-transform: none;">
                                            </div>
                                        </div>

                                        <div class="col-lg-6">
                                            <div class="form-group">
                                                <input type="text" name="subject" placeholder="Konu" required="">
                                            </div>
                                        </div>
                                        <div class="col-lg-12">
                                            <div class="form-group">
                                                <textarea name="message" placeholder="Mesajınızı girin..." required=""></textarea>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-group login-btn">
                                                <button class="btn" type="submit">Gönder</button>
                                            </div>
                                        </div>
                                    </div>
                                </form>

                            </div>
                        </div>
                    </div>
                </div>
                <div class="contact-info">
                    <div class="row">
                        <div class="col-lg-4 col-12">
                            <a href="https://www.instagram.com/arif.lev/" target="_blank" style="text-decoration: none; color: inherit;">
                                <div class="single-info">
                                    <i class="fa fa-instagram" style="font-size: 30px; color: #FFFFFF;"></i>
                                    <div class="content">
                                        <h3>@arif.lev</h3>
                                        <p>Instagramdan bana ulaşabilirsiniz</p>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="col-lg-4 col-12">
                            <a href="https://www.google.com/maps/search/?api=1&query=Sakarya+Türkiye" target="_blank" style="text-decoration: none; color: inherit;">
                                <div class="single-info">
                                    <i class="fa fa-map-marker" style="font-size: 30px; color: #FFFFFF;"></i>
                                    <div class="content">
                                        <h3>Sakarya</h3>
                                        <p>Türkiye</p>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="col-lg-4 col-12">
                            <a href="mailto:arif.kalayci44@gmail.com" style="text-decoration: none; color: inherit;">
                                <div class="single-info">
                                    <i class="fa fa-envelope"></i>
                                    <div class="content">
                                        <h3>Mail Adresi</h3>
                                        <p>arif.kalayci44@gmail.com</p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!--/ End Contact Us -->

        <!--/ End Contact Us -->


		<!--/ End Contact Us -->
		
		<!-- Footer Area -->
        <%- include('../partials/footer.ejs') %>

		<!--/ End Footer Area -->
		
		<!-- jquery Min JS -->
		<%- include('../partials/script.ejs') %>

    </body>
    <script>
        const form = document.querySelector('#request')
        const sendMessage = document.querySelector('#sendMessage')

        form.addEventListener("submit", async (e) => {
           e.preventDefault();

           const name = form.name.value
           const email = form.email.value
           const subject = form.subject.value
           const message = subject ? `[${subject}] ${form.message.value}` : form.message.value

           const submitBtn = form.querySelector('button[type="submit"]')
           submitBtn.disabled = true

           try {
              const res = await fetch('/contact', {
                 method: "POST",
                 body: JSON.stringify({ name, email, message }),
                 headers: { "Content-Type": "application/json" }
              })

              const data = await res.json();

              sendMessage.classList.toggle('alert-success', data.succeeded)
              sendMessage.classList.toggle('alert-danger', !data.succeeded)
              sendMessage.textContent = data.succeeded
                 ? "Mesajınız başarıyla gönderildi, en kısa sürede dönüş yapacağım."
                 : (data.error || "Bir hata oluştu, lütfen tekrar deneyin.")
              sendMessage.style.display = "block"

              if (data.succeeded) {
                 form.reset()
              }

              setTimeout(() => {
                 sendMessage.style.display = "none"
              }, 5000)

           } catch (err) {
              sendMessage.classList.remove('alert-success')
              sendMessage.classList.add('alert-danger')
              sendMessage.textContent = "Bağlantı hatası, lütfen tekrar deneyin."
              sendMessage.style.display = "block"
           } finally {
              submitBtn.disabled = false
           }
        })
     </script>

</html>

