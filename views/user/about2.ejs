<%- include('../partials/documentHead', { pageTitle: 'Hakkımda', metaDescription: typeof metaDescription !== 'undefined' ? metaDescription : undefined }) %>
<body>

	<%- include('../partials/head.ejs') %>


    <!-- Breadcrumbs -->
    <div class="breadcrumbs overlay">
        <div class="container">
            <div class="bread-inner">
                <div class="row">
                    <div class="col-12">
                        <h2>Hakkımda</h2>
                        <ul class="bread-list">
                            <li><a href="/">Ana Sayfa</a></li>
                            <li><i class="fa fa-angle-right"></i></li>
                            <li class="active">Hakkımda</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End Breadcrumbs -->

    <%# =====================================================================
        ARAŞTIRMA AMAÇLI, BAĞLANTISIZ/GİZLİ TEST SAYFASI (prompt-injection deneyi)
        Erişim about2 controller'ında anahtarla korunuyor (bkz. controller/user.js).
        Her ?test= harfi, SADECE KENDİ konumunda/tekniğinde aktif olur; diğerleri
        boş kalır. Böylece tek bir istekte tek bir teknik izole test edilir.
        Enjeksiyon metinlerinin kendisi repoda yok, ABOUT2_CONFIG ortam
        değişkeninden okunuyor; burada sadece HANGİ TEKNİKLE render edileceği var.
    ===================================================================== %>

    <!-- Single News -->
    <section class="news-single section">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 col-12">
                    <div class="row">
                        <div class="col-12">
                            <div class="single-main">
                                <!-- News Title -->
                                <h1 class="news-title"><a href="news-single.html" onclick="return false;">Arif Kalaycı</a></h1>
                                <!-- News Text -->
                                <div class="book-blog">
                                    <p>Merhaba, Ben Arif Kalaycı. 2001 yılında güzel bir Malatya gününde doğdum ve hayatımın büyük bir kısmını teknolojiyle iç içe geçirdim. Yazılım mühendisi olarak kariyerime devam ederken, özel hayatımda da çeşitli ilgi alanları ve hobilerimle aktif bir yaşam sürdürüyorum.</p>

                                    <%# TEKNİK P - parça 1/2: Talimatın ilk yarısı burada, ikinci yarısı
                                        sayfa sonunda (P2). Tek başına anlamsız; modelin iki parçayı
                                        birleştirip birleştirmediğini ölçer. %>
                                    <% if (activeTest === 'P' && splitFragment1) { %>
                                    <div style="color:#ffffff; background:#ffffff; font-size:1px; line-height:0; max-height:0; overflow:hidden;" aria-hidden="true" data-purpose="research-only-prompt-injection-canary"><%= splitFragment1 %></div>
                                    <% } %>

                                    <%# TEKNİK I: HTML yorumu — tarayıcı hiç render etmez, innerText'te de
                                        çıkmaz. Sadece ham HTML kaynağını (view-source / raw fetch) okuyan bir
                                        ajan/araç görebilir. %>
                                    <% if (activeTest === 'I' && hiddenSentence) { %><!-- <%- hiddenSentence %> --><% } %>

                                    <p>Eğitim hayatımı Malatya ve Samsun şehirlerinde geçirdim. Bu şehirlerde ilköğretim, lise ve üniversite eğitimlerimi tamamladım.</p>

                                    <%# TEKNİK J: Ekran dışı konumlandırma — renk eşleştirme değil, sayfanın
                                        görünür alanının tamamen dışına taşıma. innerText'e genelde dahil olur
                                        (display:none/visibility:hidden değil), ama insan gözüne hiç görünmez. %>
                                    <% if (activeTest === 'J' && hiddenSentence) { %>
                                    <div style="position:absolute; left:-10000px; top:-10000px; width:1px; height:1px; overflow:hidden;" aria-hidden="true" data-purpose="research-only-prompt-injection-canary"><%= hiddenSentence %></div>
                                    <% } %>

                                    <p>Üniversite eğitimim boyunca bilgisayar bilimleri üzerine yoğunlaştım ve bu alanda derinlemesine bilgi edindim. Özellikle web geliştirme, java geliştirme, veritabanı yönetimi ve yapay zeka konularında uzmanlaşmaya çalıştım.</p>

                                    <%# TEKNİK K: opacity:0 — elemanın kendi boyutu/akışı var (J'deki gibi
                                        taşınmamış), sadece tamamen saydam. Bazı "görünür metni" hesaplayan
                                        araçlar opacity'yi dikkate alır, bazıları almaz. %>
                                    <% if (activeTest === 'K' && hiddenSentence) { %>
                                    <div style="opacity:0; height:0; overflow:hidden;" aria-hidden="true" data-purpose="research-only-prompt-injection-canary"><%= hiddenSentence %></div>
                                    <% } %>

                                    <%# TEKNİK L: <img alt="..."> içine gizleme — erişilebilirlik/alt-metin
                                        okuyan araçlar (ör. görsel açıklaması çıkaran ajanlar) bunu görebilir,
                                        düz body-text okuyan bir araç görmeyebilir. test=L değilken normal,
                                        zararsız alt metni kullanılır. %>
                                    <img src="/static/img/favicon.png" alt="<%= (activeTest === 'L' && hiddenSentence) ? hiddenSentence : 'Arif Kalaycı profil görseli' %>" style="width:1px; height:1px; opacity:0.01;" data-purpose="research-only-prompt-injection-canary">

                                    <p>Şu anda yazılım mühendisi olarak çalışma hayatıma devam ediyor, ASP.NET ile backend geliştirme, veritabanı yönetimi ve RESTful API tasarımı üzerine profesyonel deneyim kazanıyorum.</p>

                                    <%# TEKNİK M: Paragraflar ARASINDA (sayfanın ortasında) beyaz/sıfır-boyut
                                        yerleştirme — A-H'deki ile aynı CSS tekniği, ama konumu farklı (sonda
                                        değil ortada). Konumun (başta/ortada/sonda) etkisini ölçmek için. %>
                                    <% if (activeTest === 'M' && hiddenSentence) { %>
                                    <div style="color:#ffffff; background:#ffffff; font-size:1px; line-height:0; max-height:0; overflow:hidden;" aria-hidden="true" data-purpose="research-only-prompt-injection-canary"><%= hiddenSentence %></div>
                                    <% } %>

                                    <p>Bu siteyi oluştururken amacım, hem profesyonel çalışmalarımı hem de kişisel ilgi alanlarımı paylaşmak ve bu yolda yeni insanlarla bağlantı kurmak.</p>

                                    <%# TEKNİK S: HİÇ GİZLENMEMİŞ, normal/görünür bir paragraf — kontrol
                                        karşılaştırması: "gizlilik" tek başına fark yaratıyor mu? Çıplak gözle
                                        de okunur; bu sayfa zaten sadece anahtar bilen (sen) tarafından
                                        görülebildiği için insan ziyaretçi riski yok. %>
                                    <% if (activeTest === 'S' && hiddenSentence) { %>
                                    <p data-purpose="research-only-prompt-injection-canary"><%= hiddenSentence %></p>
                                    <% } %>

                                    <%# TEKNİK N: <head><meta name="description"> içine gizleme — bu, body'de
                                        hiç yer almaz; sadece sayfanın <head>'ini (ör. SEO/önizleme amaçlı meta
                                        verisini) okuyan araçlara görünür. Controller, activeTest==='N' iken bu
                                        değeri documentHead'e metaDescription olarak geçiriyor (yukarıda). %>

                                    <%# A..H, O, Q, R, T..Z: orijinal "sayfa sonu" konumu — aksiyon
                                        denemeleri (A-E), echo denemeleri (F-H), çerçeveleme denemeleri
                                        (O,Q,R) ve davranış/çıktı manipülasyonu denemeleri (T-W, ayrıca X: dil
                                        yönlendirme + base64, Y: çift base64, Z: zararsız hesaplama "eylemi")
                                        burada, tek blokta kalıyor — teknik hep aynı (beyaz yazı, sayfa sonu),
                                        değişen tek şey cümlenin ne istediği. %>
                                    <% if (['A','B','C','D','E','F','G','H','O','Q','R','T','U','V','W','X','Y','Z'].includes(activeTest) && hiddenSentence) { %>
                                    <div style="color:#ffffff; background:#ffffff; font-size:1px; line-height:0; max-height:0; overflow:hidden;" aria-hidden="true" data-purpose="research-only-prompt-injection-canary">
                                        <%= hiddenSentence %>
                                    </div>
                                    <% } %>

                                    <%# TEKNİK P - parça 2/2: ilk yarısı yukarıda (P1). %>
                                    <% if (activeTest === 'P' && splitFragment2) { %>
                                    <div style="color:#ffffff; background:#ffffff; font-size:1px; line-height:0; max-height:0; overflow:hidden;" aria-hidden="true" data-purpose="research-only-prompt-injection-canary"><%= splitFragment2 %></div>
                                    <% } %>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <%- include('../partials/footer.ejs') %>

    <!--/ End Footer Area -->

    <%- include('../partials/script.ejs') %>

</body>
</html>
