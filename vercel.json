{
    "version": 2,
    "builds":[
        {
            "src":"./index.js",
            "use":"@vercel/node"
        }
    ],
    "routes":[
        {
            "src":"/(.*)",
            "dest":"/"
        }
    ],
    "crons":[
        {
            "path":"/api/cron/monthly-report",
            "schedule":"0 6 1 * *"
        }
    ]
}