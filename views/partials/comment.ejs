                            <!-- yorum -->
							<div class="col-12">
								<div class="comments-form">
									<h2>Yorum Bırakın</h2>
									<!-- Contact Form -->
									<form class="form" method="POST" action="#">

                                        <div class="col-md-12">
                                            <div style="display:none ;" class="alert alert-success" id="sendMessage"></div>
                                         </div>

										<div class="row">
											<div class="col-lg-6 col-md-6 col-12">
												<div class="form-group">
													<i class="fa fa-user"></i>
													<input type="text" name="name" placeholder="İsim Soyisim" required="required">
												</div>
											</div>
											<div class="col-lg-6 col-md-6 col-12">
												<div class="form-group">
													<i class="fa fa-envelope"></i>
													<input type="email" name="email" placeholder="Email" required="required">
												</div>
											</div>
											<div class="col-12">
												<div class="form-group message">
													<i class="fa fa-pencil"></i>
													<textarea name="message" rows="7" placeholder="Yorum" ></textarea>
												</div>
											</div>
											<div class="col-12">
												<div class="form-group button">	
													<button type="submit" class="btn primary"><i class="fa fa-send"></i>Yorum Gönder</button>
												</div>
											</div>
										</div>
									</form>
									<!--/ End Contact Form -->
								</div>
							</div>

                            <script>
                                const commentForm = document.querySelector('.comments-form form')
                                const commentMessage = commentForm.querySelector('#sendMessage')

                                commentForm.addEventListener("submit", async (e) => {
                                   e.preventDefault();

                                   const name = commentForm.name.value
                                   const email = commentForm.email.value
                                   const message = commentForm.message.value

                                   try {
                                      const res = await fetch('/contact', {
                                         method: "POST",
                                         body: JSON.stringify({ name, email, message }),
                                         headers: { "Content-Type": "application/json" }
                                      })

                                      const data = await res.json();

                                      commentMessage.classList.toggle('alert-success', data.succeeded)
                                      commentMessage.classList.toggle('alert-danger', !data.succeeded)
                                      commentMessage.textContent = data.succeeded
                                         ? "Yorumunuz değerlendirmeye alınmıştır. Teşekkürler..."
                                         : (data.error || "Bir hata oluştu, lütfen tekrar deneyin.")
                                      commentMessage.style.display = "block"

                                      if (data.succeeded) {
                                         commentForm.reset()
                                      }

                                      setTimeout(() => {
                                         commentMessage.style.display = "none"
                                      }, 5000)

                                   } catch (err) {
                                      commentMessage.classList.remove('alert-success')
                                      commentMessage.classList.add('alert-danger')
                                      commentMessage.textContent = "Bağlantı hatası, lütfen tekrar deneyin."
                                      commentMessage.style.display = "block"
                                   }
                                })
                             </script>
                    
                    