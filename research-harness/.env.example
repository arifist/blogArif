# Bu dosyayı "research-harness/.env" olarak kopyala ve gerçek anahtarını yaz.
# research-harness/.env zaten repo kökündeki .gitignore'da (bare ".env" kuralı
# her dizindeki .env dosyasını kapsar) — commit edilmez.

GEMINI_API_KEY=buraya-kendi-anahtarini-yaz

# ABOUT2_CONFIG'deki KEY= değeriyle AYNI olmalı (test sayfasına erişim anahtarı).
# Koda sabit yazılmıyor, buradan okunuyor.
PIT_ACCESS_KEY=buraya-about2-erisim-anahtarini-yaz

# İsteğe bağlı, varsayılan: gemini-2.0-flash
# GEMINI_MODEL=gemini-2.0-flash
